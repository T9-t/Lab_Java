<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss} %-5level %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="MESSAGE-FILE" class="ch.qos.logback.core.FileAppender">
        <file>serverMessages.log</file>
        <append>true</append>
        <encoder>
            <pattern>%date %-5level %logger - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="ERROR-FILE" class="ch.qos.logback.core.FileAppender">
        <file>serverErrors.log</file>
        <append>true</append>
        <encoder>
            <pattern>%date %-5level %logger - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="errors" level="WARN" additivity="false">
        <appender-ref ref="ERROR-FILE"/>
    </logger>

    <root level="INFO">
        <appender-ref ref="MESSAGE-FILE"/>
        <!-- <appender-ref ref="CONSOLE" /> -->
    </root>
</configuration>